# Database
DB_USER=upworkradar
DB_PASSWORD=your_secure_password_here

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Apify
APIFY_API_KEY=apify_api_...

# Resend (email)
RESEND_API_KEY=re_...
FROM_EMAIL=UpworkRadar <radar@yourdomain.com>

# App
NODE_ENV=production
PORT=3001
FRONTEND_URL=http://YOUR_VPS_IP:5173

# Frontend build-time API URL (Vite inlines this at build).
# Point this at the backend as reachable from the BROWSER (your VPS IP).
VITE_API_URL=http://YOUR_VPS_IP:3001/api
